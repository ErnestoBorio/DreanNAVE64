{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Build & Launch Retro Debugger",
			"type": "node",
			"request": "launch",
			"preLaunchTask": "Build PRG Only",
			"runtimeExecutable": "${workspaceFolder}/run_debugger.sh",
			"console": "integratedTerminal"
		},
		{
			"name": "Build & Launch VICE",
			"type": "node",
			"request": "launch",
			"preLaunchTask": "Build PRG Only",
			"runtimeExecutable": "${workspaceFolder}/run_vice.sh",
			"console": "integratedTerminal"
		},
		{
			"name": "Launch VICE (No Build)",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "${workspaceFolder}/run_vice.sh",
			"runtimeArgs": ["--no-build"],
			"console": "integratedTerminal"
		}
	]
}
